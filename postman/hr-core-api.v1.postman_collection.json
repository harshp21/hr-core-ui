          "name": "POST Create Employee",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = `${Date.now()}-${Math.floor(Math.random() * 10000)}`;",
                  "pm.collectionVariables.set('employeeCode', `EMP-${suffix}`);",
                  "pm.collectionVariables.set('employeeEmail', `john.${suffix}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const payload = pm.response.json();",
                  "pm.test('response envelope is valid', function () {",
                  "  pm.expect(payload).to.have.property('success', true);",
                  "  pm.expect(payload).to.have.property('response');",
                  "  pm.expect(payload.response).to.have.property('id');",
                  "});",
                  "pm.collectionVariables.set('employeeId', payload.response.id);",
                  "pm.collectionVariables.set('duplicateEmployeeCode', payload.response.employeeCode);"
                ]
              }
            }
